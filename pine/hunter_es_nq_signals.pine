//@version=6
// Hunter ES/NQ Signals
// BUY/SELL when price tests an institutional level (prior RTH H/L/C, overnight H/L,
// opening range, floor pivots, RTH VWAP + bands), prints a reversal candle on
// above-average volume, inside allowed time windows / quarter-hours.
// Every signal is tracked to target (R multiple), stop, or timeout. The win % printed on a
// signal uses ONLY signals that came before it (no peeking), bucketed by direction and
// quarter of the hour. Everything evaluates on confirmed bars, so nothing repaints.
// Built for intraday charts (1-15m) on ES, NQ, MES, MNQ. Times are New York.
indicator("Hunter ES/NQ Signals", shorttitle = "HuntSig", overlay = true, max_labels_count = 500)

tz = "America/New_York"

// ───────────────────────── Inputs ─────────────────────────
grpL = "Levels"
rthSess = input.session("0930-1600", "RTH session", group = grpL)
onSess  = input.session("1800-0930", "Overnight session", group = grpL)
orSess  = input.session("0930-0945", "Opening range", group = grpL)
showLv  = input.bool(true, "Plot levels", group = grpL)
usePiv  = input.bool(true, "Use floor pivots (P/R1/R2/S1/S2)", group = grpL)
useVw   = input.bool(true, "Use RTH VWAP + bands", group = grpL)
vwMult  = input.float(2.0, "VWAP band stdev", minval = 0.1, step = 0.1, group = grpL)

grpS = "Signal rules"
tolAtr   = input.float(0.15, "Level touch tolerance (x ATR)", minval = 0, step = 0.05, group = grpS)
maxDist  = input.float(1.0, "Max close distance from level (x ATR)", minval = 0.1, step = 0.1, group = grpS)
usePat   = input.bool(true, "Require candlestick pattern (engulf / hammer / star)", group = grpS)
minRvol  = input.float(1.2, "Min relative volume", minval = 0, step = 0.1, group = grpS)
trendF   = input.string("None", "Trend filter", options = ["None", "VWAP side", "EMA 20/50"], group = grpS)
cooldown = input.int(3, "Min bars between signals", minval = 0, group = grpS)

grpT = "Time filters (New York)"
useWinA = input.bool(true, "Window A", inline = "a", group = grpT)
winA    = input.session("0930-1130", "", inline = "a", group = grpT)
useWinB = input.bool(true, "Window B", inline = "b", group = grpT)
winB    = input.session("1330-1600", "", inline = "b", group = grpT)
q1 = input.bool(true, ":00-:14", inline = "q", group = grpT)
q2 = input.bool(true, ":15-:29", inline = "q", group = grpT)
q3 = input.bool(true, ":30-:44", inline = "q", group = grpT)
q4 = input.bool(true, ":45-:59", inline = "q", group = grpT)

grpV = "Volume candles"
colorBars  = input.bool(true, "Color candles by relative volume", group = grpV)
rvolLen    = input.int(20, "Volume average length", minval = 2, group = grpV)
hiRvol     = input.float(1.5, "High volume >= x avg", minval = 1, step = 0.1, group = grpV)
climaxRvol = input.float(2.5, "Climax volume >= x avg", minval = 1, step = 0.1, group = grpV)
lowRvol    = input.float(0.6, "Low volume <= x avg", minval = 0, step = 0.1, group = grpV)

grpP = "Probability tracker"
rr      = input.float(2.0, "Target (R multiple)", minval = 0.5, step = 0.25, group = grpP)
stopBuf = input.float(0.1, "Stop buffer beyond candle/level (x ATR)", minval = 0, step = 0.05, group = grpP)
maxBars = input.int(24, "Timeout after N bars", minval = 1, group = grpP)
minN    = input.int(20, "Samples needed before trusting win %", minval = 1, group = grpP)
showTbl = input.bool(true, "Show stats table", group = grpP)

// ───────────────────────── Core ─────────────────────────
atr    = ta.atr(14)
volAvg = ta.sma(volume, rvolLen)
rvol   = volAvg > 0 ? volume / volAvg : 0.0

inRth    = not na(time(timeframe.period, rthSess, tz))
inOn     = not na(time(timeframe.period, onSess, tz))
inOr     = not na(time(timeframe.period, orSess, tz))
rthStart = inRth and not inRth[1]
onStart  = inOn and not inOn[1]
orStart  = inOr and not inOr[1]

// ───────────────────────── Session levels ─────────────────────────
var float curH  = na
var float curL  = na
var float curC  = na
var float pdh   = na
var float pdl   = na
var float pdc   = na
var float onH   = na
var float onL   = na
var float onHfx = na
var float onLfx = na
var float orH   = na
var float orL   = na

if onStart
    onH := high
    onL := low
else if inOn
    onH := math.max(onH, high)
    onL := math.min(onL, low)

if rthStart
    if not na(curH)
        pdh := curH
        pdl := curL
        pdc := curC
    curH  := high
    curL  := low
    onHfx := onH
    onLfx := onL
else if inRth
    curH := math.max(curH, high)
    curL := math.min(curL, low)
if inRth
    curC := close

if orStart
    orH := high
    orL := low
else if inOr
    orH := math.max(orH, high)
    orL := math.min(orL, low)

onHi = inRth ? onHfx : na
onLo = inRth ? onLfx : na
orHi = inRth and not inOr ? orH : na
orLo = inRth and not inOr ? orL : na

pp = (pdh + pdl + pdc) / 3
r1 = 2 * pp - pdl
s1 = 2 * pp - pdh
r2 = pp + (pdh - pdl)
s2 = pp - (pdh - pdl)

[vw, vwUp, vwDn] = ta.vwap(hlc3, rthStart, vwMult)
vwL  = useVw and inRth ? vw : na
vwUL = useVw and inRth ? vwUp : na
vwDL = useVw and inRth ? vwDn : na

ppL = usePiv ? pp : na
r1L = usePiv ? r1 : na
r2L = usePiv ? r2 : na
s1L = usePiv ? s1 : na
s2L = usePiv ? s2 : na

lvVals = array.from(pdh, pdl, pdc, onHi, onLo, orHi, orLo, ppL, r1L, r2L, s1L, s2L, vwL, vwUL, vwDL)
var lvNames = array.from("PDH", "PDL", "PDC", "ONH", "ONL", "ORH", "ORL", "P", "R1", "R2", "S1", "S2", "VWAP", "VWAP+", "VWAP-")

// Nearest level that was tested and held this bar
tol = tolAtr * atr
float longLvPx  = na
float shortLvPx = na
longLvName  = ""
shortLvName = ""
bestL = 1e10
bestS = 1e10
if not na(atr)
    for i = 0 to lvVals.size() - 1
        lv = lvVals.get(i)
        if not na(lv)
            if low <= lv + tol and close > lv and close - lv <= maxDist * atr and close - lv < bestL
                bestL     := close - lv
                longLvPx  := lv
                longLvName := lvNames.get(i)
            if high >= lv - tol and close < lv and lv - close <= maxDist * atr and lv - close < bestS
                bestS      := lv - close
                shortLvPx  := lv
                shortLvName := lvNames.get(i)

// ───────────────────────── Candlestick patterns ─────────────────────────
body = math.abs(close - open)
rng  = high - low
upW  = high - math.max(open, close)
dnW  = math.min(open, close) - low

bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and body > body[1]
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and body > body[1]
hammer  = rng > 0 and dnW >= 2 * body and dnW >= 0.5 * rng and upW <= 0.3 * rng
star    = rng > 0 and upW >= 2 * body and upW >= 0.5 * rng and dnW <= 0.3 * rng

bullPat  = bullEng or hammer
bearPat  = bearEng or star
bullName = bullEng ? "Engulf" : hammer ? "Hammer" : "No pattern"
bearName = bearEng ? "Engulf" : star ? "Star" : "No pattern"

// ───────────────────────── Filters ─────────────────────────
e20 = ta.ema(close, 20)
e50 = ta.ema(close, 50)
trendLong  = trendF == "None" or (trendF == "VWAP side" and close > vw) or (trendF == "EMA 20/50" and e20 > e50)
trendShort = trendF == "None" or (trendF == "VWAP side" and close < vw) or (trendF == "EMA 20/50" and e20 < e50)

inA   = not na(time(timeframe.period, winA, tz))
inB   = not na(time(timeframe.period, winB, tz))
inWin = (not useWinA and not useWinB) or (useWinA and inA) or (useWinB and inB)

mnt = minute(time, tz)
qtr = math.floor(mnt / 15.0)
qOk = (qtr == 0 and q1) or (qtr == 1 and q2) or (qtr == 2 and q3) or (qtr == 3 and q4)

var int lastSigBar = -100000
coolOk = bar_index - lastSigBar > cooldown

sigLong  = barstate.isconfirmed and not na(longLvPx) and (not usePat or bullPat) and rvol >= minRvol and trendLong and inWin and qOk and coolOk
sigShort = barstate.isconfirmed and not na(shortLvPx) and (not usePat or bearPat) and rvol >= minRvol and trendShort and inWin and qOk and coolOk

// ───────────────────────── Probability tracker ─────────────────────────
type Trade
    int dir
    float entry
    float stop
    float target
    int bar
    int key

var array<Trade> trades = array.new<Trade>()
// keys 0-3 = long by quarter-hour, 4-7 = short by quarter-hour
var array<int>   stN = array.new<int>(8, 0)
var array<int>   stW = array.new<int>(8, 0)
var array<float> stR = array.new<float>(8, 0.0)

// Resolve open trades first (stop wins ties = conservative)
if barstate.isconfirmed and trades.size() > 0
    for i = trades.size() - 1 to 0
        t = trades.get(i)
        if bar_index > t.bar
            risk     = math.abs(t.entry - t.stop)
            hitStop  = t.dir == 1 ? low <= t.stop : high >= t.stop
            hitTgt   = t.dir == 1 ? high >= t.target : low <= t.target
            timedOut = bar_index - t.bar >= maxBars
            if hitStop or hitTgt or timedOut
                r = hitStop ? -1.0 : hitTgt ? rr : (close - t.entry) * t.dir / risk
                stN.set(t.key, stN.get(t.key) + 1)
                if hitTgt and not hitStop
                    stW.set(t.key, stW.get(t.key) + 1)
                stR.set(t.key, stR.get(t.key) + r)
                trades.remove(i)

fmtR(x) =>
    (x >= 0 ? "+" : "") + str.tostring(x, "0.00")

// New signal (skip bars that qualify both ways)
if sigLong != sigShort
    dir  = sigLong ? 1 : -1
    lvPx = sigLong ? longLvPx : shortLvPx
    stop = sigLong ? math.min(low, lvPx) - stopBuf * atr : math.max(high, lvPx) + stopBuf * atr
    risk = math.abs(close - stop)
    if risk > 0
        tgt = close + dir * rr * risk
        key = (sigLong ? 0 : 4) + qtr
        n   = stN.get(key)
        w   = stW.get(key)
        pct = n > 0 ? str.tostring(100.0 * w / n, "0") + "%" : "new"
        chartTxt = (sigLong ? "BUY " : "SELL ") + pct + (n > 0 and n < minN ? "?" : "")
        tip = (sigLong ? "BUY" : "SELL") + " @ " + str.tostring(close, format.mintick) +
             "\nLevel: " + (sigLong ? longLvName : shortLvName) + " " + str.tostring(lvPx, format.mintick) +
             "\nPattern: " + (sigLong ? bullName : bearName) +
             "\nRVOL: " + str.tostring(rvol, "0.0") + "x" +
             "\nQuarter: :" + str.tostring(qtr * 15, "00") + "-:" + str.tostring(qtr * 15 + 14, "00") +
             "\nStop: " + str.tostring(stop, format.mintick) + "   Target (" + str.tostring(rr, "0.0#") + "R): " + str.tostring(tgt, format.mintick) +
             "\nHistory (this side + quarter): " + (n > 0 ? str.tostring(100.0 * w / n, "0") + "% win, n=" + str.tostring(n) + ", exp " + fmtR(stR.get(key) / n) + "R" : "no prior signals") +
             (n > 0 and n < minN ? "\n(low sample — don't trust it yet)" : "")
        label.new(bar_index, sigLong ? low : high, chartTxt, style = sigLong ? label.style_label_up : label.style_label_down, color = sigLong ? color.new(#00C853, 0) : color.new(#D50000, 0), textcolor = color.white, size = size.small, tooltip = tip)
        trades.push(Trade.new(dir, close, stop, tgt, bar_index, key))
        lastSigBar := bar_index
        alert(syminfo.ticker + " " + tip, alert.freq_once_per_bar_close)

alertcondition(sigLong and not sigShort, "Hunter BUY", "Hunter BUY on {{ticker}} {{interval}} @ {{close}}")
alertcondition(sigShort and not sigLong, "Hunter SELL", "Hunter SELL on {{ticker}} {{interval}} @ {{close}}")

// ───────────────────────── Volume candles ─────────────────────────
isUp = close >= open
vcol = rvol >= climaxRvol ? (isUp ? #00FF00 : #FF00FF) : rvol >= hiRvol ? (isUp ? #00C853 : #D50000) : rvol <= lowRvol ? color.new(color.gray, 40) : na
barcolor(colorBars ? vcol : na, title = "Volume candles")

// ───────────────────────── Level plots ─────────────────────────
f_br(x) =>
    x != x[1] ? na : x

pdhP = f_br(pdh)
pdlP = f_br(pdl)
pdcP = f_br(pdc)
onhP = f_br(onHi)
onlP = f_br(onLo)
orhP = f_br(orHi)
orlP = f_br(orLo)
ppP  = f_br(ppL)
r1P  = f_br(r1L)
r2P  = f_br(r2L)
s1P  = f_br(s1L)
s2P  = f_br(s2L)

plot(showLv ? pdhP : na, "PDH", color = color.new(color.red, 0), linewidth = 2, style = plot.style_steplinebr)
plot(showLv ? pdlP : na, "PDL", color = color.new(color.green, 0), linewidth = 2, style = plot.style_steplinebr)
plot(showLv ? pdcP : na, "PDC", color = color.new(color.gray, 0), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? onhP : na, "ONH", color = color.new(color.orange, 0), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? onlP : na, "ONL", color = color.new(color.aqua, 0), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? orhP : na, "ORH", color = color.new(color.yellow, 0), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? orlP : na, "ORL", color = color.new(color.yellow, 0), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? ppP : na, "P", color = color.new(color.white, 30), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? r1P : na, "R1", color = color.new(color.red, 50), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? r2P : na, "R2", color = color.new(color.red, 50), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? s1P : na, "S1", color = color.new(color.green, 50), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? s2P : na, "S2", color = color.new(color.green, 50), linewidth = 1, style = plot.style_steplinebr)
plot(showLv ? vwL : na, "VWAP", color = color.new(color.fuchsia, 0), linewidth = 2, style = plot.style_linebr)
plot(showLv ? vwUL : na, "VWAP +band", color = color.new(color.fuchsia, 60), linewidth = 1, style = plot.style_linebr)
plot(showLv ? vwDL : na, "VWAP -band", color = color.new(color.fuchsia, 60), linewidth = 1, style = plot.style_linebr)

// Level name tags on the right edge
var array<label> lvTags = array.new<label>()
if showLv and barstate.islast
    if lvTags.size() == 0
        for i = 0 to lvNames.size() - 1
            lvTags.push(label.new(bar_index, na, lvNames.get(i), style = label.style_label_left, color = color(na), textcolor = color.gray, size = size.tiny))
    for i = 0 to lvVals.size() - 1
        lvTags.get(i).set_xy(bar_index + 2, lvVals.get(i))

// ───────────────────────── Stats table ─────────────────────────
var table st = table.new(position.bottom_right, 4, 10, border_width = 1, border_color = color.new(color.white, 70))
var qNames = array.from(":00-:14", ":15-:29", ":30-:44", ":45-:59")

f_row(row, c0, c1, c2, c3, bg) =>
    table.cell(st, 0, row, c0, text_color = color.white, bgcolor = bg, text_size = size.small)
    table.cell(st, 1, row, c1, text_color = color.white, bgcolor = bg, text_size = size.small)
    table.cell(st, 2, row, c2, text_color = color.white, bgcolor = bg, text_size = size.small)
    table.cell(st, 3, row, c3, text_color = color.white, bgcolor = bg, text_size = size.small)

if showTbl and barstate.islast
    f_row(0, "Setup", "n", "Win %", "Exp R", color.new(#0D1B2A, 0))
    totN = 0
    totW = 0
    totR = 0.0
    for k = 0 to 7
        n = stN.get(k)
        w = stW.get(k)
        totN += n
        totW += w
        totR += stR.get(k)
        e  = n > 0 ? stR.get(k) / n : 0.0
        bg = n < minN ? color.new(color.gray, 50) : e > 0 ? color.new(color.green, 30) : color.new(color.red, 30)
        f_row(k + 1, (k < 4 ? "Long " : "Short ") + qNames.get(k % 4), str.tostring(n), n > 0 ? str.tostring(100.0 * w / n, "0") : "—", n > 0 ? fmtR(e) : "—", bg)
    f_row(9, "ALL", str.tostring(totN), totN > 0 ? str.tostring(100.0 * totW / totN, "0") : "—", totN > 0 ? fmtR(totR / totN) : "—", color.new(#1E3A5F, 0))
